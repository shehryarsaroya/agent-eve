{
  "name": "@thecompact/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test scripts --max-warnings 0",
    "audit:scale": "node scripts/scale-audit.mjs",
    "audit:budgets": "node scripts/budget-audit.mjs",
    "gate0": "npm run typecheck && npm run lint && npm run audit:scale && npm run audit:budgets && npm run test",
    "sim": "tsx src/sim/cli.ts",
    "api": "tsx src/api/server.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
