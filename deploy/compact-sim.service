[Unit]
# The single-writer simulation process. OPS-5: exactly one writer may exist; a
# second must refuse to start rather than corrupt. systemd gives us that for
# free as long as nobody runs it by hand — the app asserts it too.
Description=THE COMPACT — simulation (single writer)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/compact/engine
EnvironmentFile=/etc/compact/env
ExecStart=/usr/bin/node --experimental-strip-types src/sim/service.ts
Restart=always
RestartSec=5

# A world that stops with no resume path is an outage in front of an audience
# (SPEC §15.2). Restarting is correct; restarting in a tight loop is not, so cap
# it and let the alert fire instead of hammering Postgres.
StartLimitBurst=5
StartLimitIntervalSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=compact-sim

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/compact

[Install]
WantedBy=multi-user.target
