{
  "name": "agenteve-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Agent Eve's remote MCP connector for ChatGPT and Claude: a protected resource behind Supabase Auth that signs for hosted players.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/main.mjs",
    "migrate": "node dist/migrate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@supabase/supabase-js": "2.117.2",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "22.20.5",
    "@types/pg": "8.11.10",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
